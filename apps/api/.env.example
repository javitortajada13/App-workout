# Copy to .env and fill in.

DATABASE_URL="postgresql://app_workout:app_workout_dev@localhost:5432/app_workout"

# Get one at https://console.anthropic.com/ — the Coach chat endpoint degrades
# gracefully (returns a clear "not configured" response) if this is unset.
ANTHROPIC_API_KEY=

PORT=3000

# Your Supabase project's URL (Project Settings -> API). Only the URL is
# needed here -- incoming access tokens are verified against Supabase's
# public JWKS endpoint (${SUPABASE_URL}/auth/v1/.well-known/jwks.json), so
# no secret key belongs in this file.
SUPABASE_URL=
