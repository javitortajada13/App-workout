# Copy to .env. Defaults to localhost, which works for web and the iOS
# simulator. Android emulator needs http://10.0.2.2:3000 instead. A physical
# device needs your machine's LAN IP (e.g. http://192.168.1.23:3000) --
# localhost on a phone means the phone itself, not your computer.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Your Supabase project's URL and "anon"/"publishable" key (Project Settings
# -> API). Both are safe to ship in a client app -- never put a "service_role"
# or "secret" key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
